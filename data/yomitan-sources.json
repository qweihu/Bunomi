{
  "schema_version": 1,
  "repository": "yomidevs/jmdict-yomitan",
  "release_api": "https://api.github.com/repos/yomidevs/jmdict-yomitan/releases/latest",
  "release_page": "https://github.com/yomidevs/jmdict-yomitan/releases/latest",
  "default_assets": [
    {
      "filename": "JMdict_english_without_proper_names.zip",
      "kind": "terms",
      "role": "通用词条、读音、释义和词语关系；与 JMnedict 分开时避免专有名词重复"
    },
    {
      "filename": "JMnedict.zip",
      "kind": "names",
      "role": "人名、地名和其他专有名词的候选读音"
    },
    {
      "filename": "KANJIDIC_english.zip",
      "kind": "kanji",
      "role": "单汉字音读、训读、笔画和基础汉字信息"
    },
    {
      "filename": "JMdict_forms.zip",
      "kind": "forms",
      "role": "词形归一化和活用候选；不直接替代 Sudachi 分词"
    }
  ],
  "optional_assets": [
    {
      "filename": "JMdict_english_with_examples.zip",
      "kind": "terms-with-examples",
      "role": "需要展示词典例句或生成学习卡片时再下载"
    }
  ],
  "policy": {
    "runtime_role": "enrichment-and-audit",
    "primary_reading_engine": "sudachi",
    "do_not_silently_override_engine": true,
    "keep_raw_archives_out_of_package": true,
    "record_release_sha256": true,
    "retain_upstream_license_notices": true
  }
}
